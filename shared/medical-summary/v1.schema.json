{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:health-wallet:medical-summary:v1",
  "$defs": {
    "Scope": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$(?![\\s\\S])"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$(?![\\s\\S])"
        },
        "scope_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
        }
      },
      "required": [
        "request_id",
        "source_ref",
        "scope_token"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$(?![\\s\\S])"
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "end_byte": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "page": {
          "type": "null"
        }
      },
      "required": [
        "source_ref",
        "start_byte",
        "end_byte",
        "quote",
        "page"
      ],
      "additionalProperties": false
    },
    "QuotedText": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "text",
        "evidence"
      ],
      "additionalProperties": false
    },
    "DecimalValue": {
      "type": "object",
      "properties": {
        "decimal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:[+-]?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+))$(?![\\s\\S])"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "decimal",
        "evidence"
      ],
      "additionalProperties": false
    },
    "Operator": {
      "type": "object",
      "properties": {
        "symbol": {
          "enum": [
            "=",
            "<",
            ">",
            "≤",
            "≥"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "symbol",
        "evidence"
      ],
      "additionalProperties": false
    },
    "ReportedFlag": {
      "type": "object",
      "properties": {
        "value": {
          "enum": [
            "high",
            "low",
            "normal"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "value",
        "evidence"
      ],
      "additionalProperties": false
    },
    "Measurement": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/QuotedText"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecimalValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "operator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Operator"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuotedText"
            },
            {
              "type": "null"
            }
          ]
        },
        "reported_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuotedText"
            },
            {
              "type": "null"
            }
          ]
        },
        "reported_flag": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportedFlag"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label",
        "value",
        "operator",
        "unit",
        "reported_range",
        "reported_flag"
      ],
      "additionalProperties": false
    },
    "Fact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(?:F[1-9][0-9]{0,3})$(?![\\s\\S])"
        },
        "kind": {
          "enum": [
            "reported_finding",
            "reported_diagnosis",
            "measurement"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "certainty": {
          "enum": [
            "explicit",
            "ambiguous"
          ]
        },
        "polarity": {
          "enum": [
            "affirmed",
            "negated",
            "unknown"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "conflict_group": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^(?:C[1-9][0-9]{0,3})$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "term_ids": {
          "type": "array",
          "items": {
            "enum": [
              "glucose",
              "hemoglobin",
              "ocr",
              "reference_range"
            ]
          },
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true
        },
        "measurement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Measurement"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "evidence",
        "certainty",
        "polarity",
        "required",
        "conflict_group",
        "term_ids",
        "measurement"
      ],
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "text_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
        },
        "original_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
        },
        "metadata_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
        },
        "processing_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "extraction_status": {
          "enum": [
            "completed",
            "incomplete",
            "failed"
          ]
        },
        "method": {
          "enum": [
            "pdf_text",
            "ocr",
            "mixed"
          ]
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "text",
        "text_sha256",
        "original_sha256",
        "metadata_sha256",
        "processing_attempt",
        "extraction_status",
        "method",
        "page_count"
      ],
      "additionalProperties": false
    },
    "SummaryInputV1": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "medical-summary-input"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": [
        "schema_version",
        "kind",
        "scope",
        "source",
        "facts"
      ],
      "additionalProperties": false
    },
    "SummaryProvenanceV1": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "input_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
        },
        "pipeline_version": {
          "const": "summary-contract-v1"
        },
        "prompt_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:[A-Za-z0-9_.-]+)$(?![\\s\\S])"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9_./:-]+)$(?![\\s\\S])"
        },
        "model_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:[A-Za-z0-9_./:-]+)$(?![\\s\\S])"
        }
      },
      "required": [
        "schema_version",
        "input_sha256",
        "pipeline_version",
        "prompt_sha256",
        "provider",
        "model_id",
        "model_revision"
      ],
      "additionalProperties": false
    },
    "Uncertainty": {
      "type": "object",
      "properties": {
        "codes": {
          "type": "array",
          "items": {
            "enum": [
              "ambiguous_source",
              "conflicting_findings",
              "limited_coverage",
              "missing_measurement_value",
              "missing_unit",
              "ocr_used",
              "page_locations_unavailable"
            ]
          },
          "minItems": 0,
          "maxItems": 7,
          "uniqueItems": true
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^(?:F[1-9][0-9]{0,3})$(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "codes",
        "fact_ids"
      ],
      "additionalProperties": false
    },
    "SummaryOutputV1": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "medical-summary-output"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "reported_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "educational_explanations": {
          "type": "array",
          "items": {
            "enum": [
              "glucose",
              "hemoglobin",
              "ocr",
              "reference_range"
            ]
          },
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true
        },
        "uncertainty": {
          "$ref": "#/$defs/Uncertainty"
        },
        "catalogue_coverage": {
          "enum": [
            "all_catalogued",
            "subset"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/SummaryProvenanceV1"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "scope",
        "reported_findings",
        "educational_explanations",
        "uncertainty",
        "catalogue_coverage",
        "provenance"
      ],
      "additionalProperties": false
    }
  }
}
