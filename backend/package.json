{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/database/migrate.ts up",
    "db:status": "tsx src/database/migrate.ts status",
    "db:test": "tsx --test src/database/schema.test.ts",
    "db:provision": "node ../infrastructure/scripts/provision-roles.mjs",
    "db:security:test": "tsx --test src/database/security.test.ts",
    "auth:test": "tsx --test src/auth/auth.test.ts",
    "documents:test": "tsx --test src/documents/*.test.ts",
    "processing:test": "tsx --test --test-concurrency=1 src/processing/*.test.ts",
    "integration:s3-ocr": "tsx src/integration/cli.ts",
    "integration:s3-ocr:test": "tsx --test --test-concurrency=1 src/integration-checks/live-s3-ocr.check.ts",
    "processing:service": "tsx src/processing/background-entry.ts",
    "processing:service:test": "tsx --test --test-concurrency=1 src/background-checks/*.check.ts",
    "integration:stage-b": "node ../infrastructure/stage-b/run.mjs",
    "processing:service:db:test": "tsx --test --test-concurrency=1 src/background-db-checks/*.check.ts",
    "integration:stage-c": "tsx src/stage-c/cli.ts",
    "integration:stage-c:test": "tsx --test --test-concurrency=1 src/canary-checks/*.check.ts",
    "integration:stage-c:db:test": "tsx --test --test-concurrency=1 src/canary-checks/*.canary.ts",
    "integration:stage-c:supervision:test": "tsx src/canary-checks/supervision-probe.ts --offline-supervision-probe",
    "summaries:contracts:test": "tsx --test --test-concurrency=1 src/summary-checks/*.check.ts",
    "summaries:contracts:check": "python3 ../ai-service/tools/generate_contracts.py --check",
    "summaries:service:test": "tsx --test --test-concurrency=1 src/summary-checks/*.service.ts",
    "summaries:jobs:db:test": "tsx --test --test-concurrency=1 src/summary-db-checks/*.check.ts",
    "integration:summary-db": "node ../infrastructure/summary-db/run.mjs",
    "summaries:jobs:test": "tsx --test --test-concurrency=1 src/summary-checks/*.unit.ts",
    "summaries:executor": "tsx src/summaries/executor-entry.ts",
    "summaries:evaluate": "PYTHONPATH=../ai-service python3 -m summary_evaluation.runner",
    "summaries:benchmark:prepare": "PYTHONPATH=../ai-service python3 -m summary_benchmark.preparation",
    "contracts:b02:test": "tsx --test --test-concurrency=1 src/b02-checks/*.check.ts",
    "contracts:b03:test": "tsx --test --test-concurrency=1 src/b03-checks/*.check.ts",
    "processing:b03:db:test": "tsx --test --test-concurrency=1 src/b03-db-checks/*.check.ts",
    "processing:operational": "tsx src/processing/operational-entry.ts",
    "requirements:check": "python3 ../infrastructure/requirements/check_prd.py --check",
    "modules:accounts:test": "tsx --test --test-concurrency=1 src/module-checks/accounts.check.ts",
    "processing:delivery:test": "tsx --test --test-concurrency=1 src/background-checks/system-delivery.check.ts",
    "processing:deployment:check": "tsx src/stage-c/deployment-entry.ts",
    "processing:delivery:closure:test": "tsx --test --test-concurrency=1 src/background-checks/trusted-delivery.check.ts",
    "processing:native-authority:test": "tsx --test --test-concurrency=1 src/background-checks/native-authority.check.ts",
    "processing:native-authority:python:test": "python3 -m unittest discover -s ../infrastructure/processing-delivery -p test_native_authority.py",
    "identity:phase1:test": "node ../infrastructure/identity/run.mjs --execute-isolated",
    "identity:email:drain": "node --import tsx src/auth/security-email-entry.ts --drain-once",
    "identity:phase1b:test": "node ../infrastructure/identity/run.mjs --execute-isolated",
    "identity:email:sandbox": "node --import tsx src/auth/security-email-sandbox.ts --local-synthetic-only",
    "phase2:guardian-documents:test": "node ../infrastructure/identity/run.mjs --execute-isolated --phase2",
    "documents:closure:test": "node ../infrastructure/identity/run.mjs --execute-isolated --m03-only",
    "phase3:test": "node ../infrastructure/identity/run.mjs --execute-isolated --phase3",
    "phase4:test": "node ../infrastructure/identity/run.mjs --execute-isolated --phase4",
    "phase5:test": "node ../infrastructure/identity/run.mjs --execute-isolated --phase5",
    "phase6:test": "node ../infrastructure/identity/run.mjs --execute-isolated --phase6",
    "phase7:test": "node ../infrastructure/identity/run.mjs --execute-isolated --phase7",
    "guardian-notifications:synthetic:once": "node --import tsx src/guardian-notifications/entry.ts --owned-synthetic-once"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "argon2": "^0.45.1",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
