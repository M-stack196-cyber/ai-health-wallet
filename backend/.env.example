NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=your_database_name
DB_USER=health_wallet_app
DB_PASSWORD=replace_with_runtime_password_generated_by_db_provision

# Authentication values below are local-development defaults, subject to production review.
# JWT_SECRET must be 32-64 cryptographically random bytes encoded as hex.
JWT_SECRET=replace_with_securely_generated_64_hex_characters
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN_SECONDS=900
JWT_ISSUER=ai-health-wallet-api
JWT_AUDIENCE=ai-health-wallet-patient
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
AUTH_HASH_CONCURRENCY=2
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Private document storage stays disabled until an existing approved bucket is configured.
DOCUMENT_STORAGE_ENABLED=false
AWS_REGION=replace_with_approved_region
S3_BUCKET=replace_with_private_bucket_name
S3_BUCKET_OWNER_ACCOUNT_ID=replace_with_12_digit_account_id
S3_DOCUMENT_PREFIX=medical-documents/
S3_ENCRYPTION=AES256
# For aws:kms, set the approved key ARN; use the AWS default credential chain.
# S3_KMS_KEY_ARN=replace_with_approved_key_arn
DOCUMENT_MAX_UPLOAD_BYTES=5242880
DOCUMENT_MAX_CONCURRENT_UPLOADS=2
DOCUMENT_UPLOAD_TIMEOUT_MS=15000
DOCUMENT_VALIDATION_TIMEOUT_MS=5000
DOCUMENT_MAX_IMAGE_PIXELS=16000000
DOCUMENT_MAX_PDF_PAGES=100
DOCUMENT_DOWNLOAD_EXPIRY_SECONDS=60
DOCUMENT_UPLOAD_RATE_LIMIT_MAX=20

# Lifecycle foundation only: no processor starts automatically.
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_LEASE_MS=60000
PROCESSING_ATTEMPT_TIMEOUT_MS=300000
PROCESSING_HEARTBEAT_MS=15000
PROCESSING_RETRY_BASE_MS=30000
PROCESSING_RETRY_MAX_MS=300000
PROCESSING_RECOVERY_BATCH_SIZE=50

# Internal input retrieval; inherits the approved AWS_PROFILE/region/bucket configuration.
PROCESSING_MAX_DOWNLOAD_BYTES=5242880
PROCESSING_DOWNLOAD_TIMEOUT_MS=15000
PROCESSING_LEASE_CHECK_INTERVAL_MS=1000
PROCESSING_MAX_CONCURRENT_RETRIEVALS=2

# Opt-in embedded PDF text extraction only; no automatic processor startup.
PDF_TEXT_MAX_FILE_BYTES=5242880
PDF_TEXT_MAX_PAGES=100
PDF_TEXT_MAX_CHARACTERS=1000000
PDF_TEXT_MAX_ITEMS=100000
PDF_TEXT_TIMEOUT_MS=10000
PDF_TEXT_MAX_CONCURRENCY=2

# Explicit opt-in OCR processor only. Development bounds, not an approved production SLA.
OCR_MAX_PAGES=50
OCR_MAX_FILE_BYTES=5242880
OCR_MAX_CHARACTERS=1000000
OCR_MAX_CONCURRENCY=1
OCR_DPI=200
OCR_MAX_EDGE=3000
OCR_MAX_PIXELS=9000000
OCR_MAX_TEMP_BYTES=16777216
OCR_PAGE_TIMEOUT_MS=20000
OCR_DOCUMENT_TIMEOUT_MS=120000
OCR_CPU_SECONDS=15
OCR_MEMORY_BYTES=536870912
OCR_MAX_OUTPUT_BYTES=4194304

# Phase 2.3 Stage A: standalone only; no API startup integration.
PROCESSING_SERVICE_ENABLED=false
PROCESSING_SERVICE_MODE=canary
PROCESSING_SERVICE_CONCURRENCY=1
PROCESSING_SERVICE_POLL_MS=2000
PROCESSING_SERVICE_DRAIN_MS=30000
PROCESSING_SERVICE_HEALTH_PORT=5001
# Leave these unset until separate activation review. Never derive a new cutoff.
# PROCESSING_CANARY_PATIENT_ID=
# PROCESSING_UPLOAD_CUTOFF=
# PROCESSING_APPROVAL_FILE=
# PROCESSING_APPROVAL_SHA256=

# Phase 1B security email. Disabled until a local sandbox or approved relay is configured.
AUTH_SECURITY_EMAIL_MODE=disabled
# Sandbox endpoint must be a literal loopback HTTP address.
AUTH_SECURITY_EMAIL_ENDPOINT=http://127.0.0.1:8026/security-email
AUTH_SECURITY_EMAIL_FROM=security@example.invalid
# Independent 32-byte random key, hexadecimal; keep in secret management, never source control.
AUTH_SECURITY_EMAIL_ENCRYPTION_KEY=
AUTH_SECURITY_EMAIL_TIMEOUT_MS=2000
AUTH_SECURITY_EMAIL_RETRY_SECONDS=30
AUTH_SECURITY_EMAIL_MAX_ATTEMPTS=3
# https-relay additionally requires owner approval, HTTPS endpoint and secret authorization.
AUTH_SECURITY_EMAIL_PROVIDER_APPROVED=false
AUTH_SECURITY_EMAIL_AUTHORIZATION=

# Explicit private Python OCR boundary; no processor/service activation by default.
# Provision an independent random 32-byte hex service token in protected runtime config.
OCR_SERVICE_URL=http://127.0.0.1:8011/v1/extractions
OCR_SERVICE_TOKEN=
OCR_SERVICE_TIMEOUT_MS=120000

# Phase 4 summary service: manual loopback launch only. Hosted LLM approval open.
# SUMMARY_PROVIDER supports synthetic-offline in the private Python entrypoint.
SUMMARY_PROVIDER=disabled
SUMMARY_SERVICE_URL=http://127.0.0.1:8012/internal/v1/report-summaries:generate
SUMMARY_SERVICE_TOKEN=

# Phase 5: only explicit synthetic/offline patient RAG composition is supported.
RAG_PROVIDER=disabled
RAG_SERVICE_URL=http://127.0.0.1:8013/internal/v1/rag/
RAG_SERVICE_TOKEN=

# M09 sharing stays disabled until a client origin is explicitly configured.
# SHARING_PUBLIC_ORIGIN=https://approved-doctor-client.example
SHARING_QR_SECONDS=3600
SHARING_LINK_SECONDS=86400
SHARING_SESSION_SECONDS=3600
SHARING_OTP_SECONDS=600
SHARING_RESEND_SECONDS=60
SHARING_OTP_ATTEMPTS=5
SHARING_OTP_REQUESTS_PER_HOUR=5

# M10 stays disabled in normal startup. Only explicit synthetic fixture workers are supported.
GUARDIAN_NOTIFICATIONS_MODE=disabled
# Synthetic worker candidates only; CFG-06/07/11/15 real-patient approval remains OPEN.
GUARDIAN_DIGEST_SECONDS=86400
GUARDIAN_REPORT_REFERENCE_SECONDS=3600
GUARDIAN_RETRY_SECONDS=30
GUARDIAN_MAX_ATTEMPTS=3
GUARDIAN_SEND_TIMEOUT_MS=2000
GUARDIAN_INDETERMINATE_POLICY=persist_only
