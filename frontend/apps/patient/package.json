{
  "name": "@health-wallet/patient",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --localhost",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform android --platform ios --max-workers 2",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@health-wallet/api": "0.1.0",
    "expo": "~55.0.32",
    "expo-clipboard": "~55.0.17",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-screen-capture": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.22",
    "react-test-renderer": "19.2.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo.*|@expo(nent)?/.*|@health-wallet/api|react-native-svg|react-native-safe-area-context)/)"
    ]
  }
}
