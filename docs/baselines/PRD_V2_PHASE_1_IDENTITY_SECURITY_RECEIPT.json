    },
    {
      "id": "T06",
      "name": "refresh rotates once, has a fixed absolute bound and replay commits family revocation"
    },
    {
      "id": "T07",
      "name": "random invalid refresh secret cannot revoke a valid session"
    },
    {
      "id": "T08",
      "name": "simultaneous refresh has one rotation and reuse permanently denies resulting credentials"
    },
    {
      "id": "T09",
      "name": "logout revokes the current session immediately without revoking another login"
    },
    {
      "id": "T10",
      "name": "absolute and idle expired sessions deny protected requests and refresh"
    },
    {
      "id": "T11",
      "name": "reset token is expiring/one-use, changes credential and invalidates every prior session"
    },
    {
      "id": "T12",
      "name": "reset racing refresh never permits pre-reset credentials to regain access"
    },
    {
      "id": "T13",
      "name": "authenticated password change rejects wrong/weak inputs and invalidates all prior sessions"
    },
    {
      "id": "T14",
      "name": "suspended/deleted/restricted/revoked accounts deny login/access/refresh; reactivation does not resurrect sessions"
    },
    {
      "id": "T15",
      "name": "cross-patient profile/document isolation and current authorization cover file, processing and summary paths"
    },
    {
      "id": "T16",
      "name": "revocation during original acquisition denies bytes before streaming"
    },
    {
      "id": "T17",
      "name": "tokens never persist plaintext; audit is minimized and append-only for runtime role"
    },
    {
      "id": "T18",
      "name": "resend/recovery endpoints apply persistent limits and generic errors"
    },
    {
      "id": "T19",
      "name": "login endpoint bounds repeated attempts including unknown identities"
    },
    {
      "id": "T20",
      "name": "missing email transport fails closed uniformly without creating an account"
    },
    {
      "id": "T21",
      "name": "simultaneous verification consumes a challenge once and database rate admission is atomic"
    },
    {
      "id": "T22",
      "name": "refresh response reflects remaining absolute expiry rather than extending it"
    },
    {
      "id": "T23",
      "name": "reset rolls back credential, challenge and sessions when required audit persistence fails"
    },
    {
      "id": "T24",
      "name": "equal idle and absolute lifetime configuration creates a valid bounded session"
    }
